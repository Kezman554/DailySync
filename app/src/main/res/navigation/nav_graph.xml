<?xml version="1.0" encoding="utf-8"?>
<navigation xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/nav_graph"
    app:startDestination="@id/tilesFragment">

    <!-- The tile grid: what the app opens on. -->
    <fragment
        android:id="@+id/tilesFragment"
        android:name="com.personalmorningalarm.ui.TilesFragment"
        android:label="@string/title_home"
        tools:layout="@layout/fragment_tiles">
        <action
            android:id="@+id/action_tiles_to_today"
            app:destination="@id/todayFragment" />
        <action
            android:id="@+id/action_tiles_to_week"
            app:destination="@id/weekScheduleFragment" />
        <action
            android:id="@+id/action_tiles_to_shoppingMenu"
            app:destination="@id/shoppingMenuFragment" />
        <action
            android:id="@+id/action_tiles_to_inbox"
            app:destination="@id/inboxFragment" />
        <action
            android:id="@+id/action_tiles_to_presence"
            app:destination="@id/presenceFragment" />
    </fragment>

    <!-- Kitchen sign-in tile: opens/closes the dashboard's presence session. -->
    <fragment
        android:id="@+id/presenceFragment"
        android:name="com.personalmorningalarm.ui.PresenceFragment"
        android:label="@string/presence_title"
        tools:layout="@layout/fragment_presence" />

    <!-- Inbox tile: the vault's 0-inbox/ captures (read-only) + a compose box. -->
    <fragment
        android:id="@+id/inboxFragment"
        android:name="com.personalmorningalarm.ui.InboxFragment"
        android:label="@string/inbox_title"
        tools:layout="@layout/fragment_inbox" />

    <!-- The Daily Schedule tile: the whole plan week, one page per day. -->
    <fragment
        android:id="@+id/weekScheduleFragment"
        android:name="com.personalmorningalarm.ui.WeekScheduleFragment"
        android:label="@string/week_schedule_title"
        tools:layout="@layout/fragment_week_schedule" />

    <!-- The alarm screen: what used to be Home. -->
    <fragment
        android:id="@+id/homeFragment"
        android:name="com.personalmorningalarm.ui.HomeFragment"
        android:label="@string/title_alarm"
        tools:layout="@layout/fragment_home">
        <!-- The Alarm tab's tiles, one screen each -->
        <action
            android:id="@+id/action_alarm_to_wakeSound"
            app:destination="@id/wakeSoundFragment" />
        <action
            android:id="@+id/action_alarm_to_nfcSettings"
            app:destination="@id/nfcSettingsFragment" />
        <action
            android:id="@+id/action_alarm_to_morningContent"
            app:destination="@id/morningContentFragment" />
        <action
            android:id="@+id/action_alarm_to_nuclear"
            app:destination="@id/nuclearSettingsFragment" />
        <action
            android:id="@+id/action_alarm_to_pin"
            app:destination="@id/alarmPinFragment" />
    </fragment>

    <fragment
        android:id="@+id/wakeSoundFragment"
        android:name="com.personalmorningalarm.ui.WakeSoundFragment"
        android:label="@string/alarm_tab_sound"
        tools:layout="@layout/fragment_wake_sound" />

    <fragment
        android:id="@+id/nfcSettingsFragment"
        android:name="com.personalmorningalarm.ui.NfcSettingsFragment"
        android:label="@string/alarm_tab_nfc"
        tools:layout="@layout/fragment_nfc_settings">
        <action
            android:id="@+id/action_nfcSettings_to_nfcTags"
            app:destination="@id/nfcTagsFragment" />
    </fragment>

    <fragment
        android:id="@+id/morningContentFragment"
        android:name="com.personalmorningalarm.ui.MorningContentFragment"
        android:label="@string/alarm_tab_content"
        tools:layout="@layout/fragment_morning_content">
        <action
            android:id="@+id/action_morningContent_to_quotes"
            app:destination="@id/quoteManagementFragment" />
        <action
            android:id="@+id/action_morningContent_to_routines"
            app:destination="@id/stretchRoutinesFragment" />
    </fragment>

    <fragment
        android:id="@+id/nuclearSettingsFragment"
        android:name="com.personalmorningalarm.ui.NuclearSettingsFragment"
        android:label="@string/alarm_tab_nuclear"
        tools:layout="@layout/fragment_nuclear_settings" />

    <fragment
        android:id="@+id/alarmPinFragment"
        android:name="com.personalmorningalarm.ui.AlarmPinFragment"
        android:label="@string/alarm_tab_pin"
        tools:layout="@layout/fragment_alarm_pin" />

    <!-- One destination, narrowed by TodayFragment.ARG_SECTION: each home tile opens
         a single feed. -->
    <fragment
        android:id="@+id/todayFragment"
        android:name="com.personalmorningalarm.ui.TodayFragment"
        android:label="@string/today_screen_title"
        tools:layout="@layout/fragment_today">
        <argument
            android:name="section"
            android:defaultValue="BOTH"
            app:argType="string" />
    </fragment>

    <!-- Shopping Lists tile: discovery menu + create, then one screen per list. -->
    <fragment
        android:id="@+id/shoppingMenuFragment"
        android:name="com.personalmorningalarm.ui.ShoppingMenuFragment"
        android:label="@string/shopping_menu_title"
        tools:layout="@layout/fragment_shopping_menu">
        <action
            android:id="@+id/action_shoppingMenu_to_shoppingList"
            app:destination="@id/shoppingListFragment" />
    </fragment>

    <fragment
        android:id="@+id/shoppingListFragment"
        android:name="com.personalmorningalarm.ui.ShoppingListFragment"
        android:label="@string/shopping_menu_title"
        tools:layout="@layout/fragment_shopping_list">
        <argument
            android:name="listId"
            app:argType="string" />
        <argument
            android:name="listTitle"
            app:argType="string" />
    </fragment>

    <fragment
        android:id="@+id/settingsFragment"
        android:name="com.personalmorningalarm.ui.SettingsFragment"
        android:label="@string/title_settings"
        tools:layout="@layout/fragment_settings" />

    <fragment
        android:id="@+id/nfcTagsFragment"
        android:name="com.personalmorningalarm.ui.NfcTagsFragment"
        android:label="@string/nfc_tags_screen_title"
        tools:layout="@layout/fragment_nfc_tags" />

    <fragment
        android:id="@+id/quoteManagementFragment"
        android:name="com.personalmorningalarm.ui.QuoteManagementFragment"
        android:label="@string/quote_management_title"
        tools:layout="@layout/fragment_quote_management" />

    <fragment
        android:id="@+id/stretchRoutinesFragment"
        android:name="com.personalmorningalarm.ui.StretchRoutinesFragment"
        android:label="@string/routines_title"
        tools:layout="@layout/fragment_stretch_routines">
        <action
            android:id="@+id/action_routines_to_edit"
            app:destination="@id/routineEditFragment" />
    </fragment>

    <fragment
        android:id="@+id/routineEditFragment"
        android:name="com.personalmorningalarm.ui.RoutineEditFragment"
        android:label="@string/routine_edit_title"
        tools:layout="@layout/fragment_routine_edit">
        <argument
            android:name="routineId"
            app:argType="long" />
    </fragment>

</navigation>
