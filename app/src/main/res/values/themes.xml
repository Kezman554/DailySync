<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">
    <!--
      DailySync theme. Colour values come from values/colors.xml (light) and
      values-night/colors.xml (dark); the DayNight parent picks between them, so the
      Light / Dark / System setting keeps working. Layouts and code reference
      colours only through these attributes. Design rules: CLAUDE.md, ## Design.
    -->
    <style name="Theme.PersonalMorningAlarm" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Accent on ground or card: text, icons, progress bars and rings -->
        <item name="colorPrimary">@color/accent</item>
        <item name="colorOnPrimary">@color/on_accent</item>
        <!-- Containers that M3 fills (FAB and friends) take the accent fill -->
        <item name="colorPrimaryContainer">@color/accent_fill</item>
        <item name="colorOnPrimaryContainer">@color/on_accent_fill</item>
        <item name="colorPrimaryInverse">@color/inverse_accent</item>
        <item name="colorSecondary">@color/accent</item>
        <item name="colorOnSecondary">@color/on_accent</item>
        <!-- Selected pills, bottom-nav indicator -->
        <item name="colorSecondaryContainer">@color/surface_2</item>
        <item name="colorOnSecondaryContainer">@color/text_primary</item>
        <item name="colorTertiary">@color/positive</item>
        <item name="colorOnTertiary">@color/on_positive</item>
        <item name="colorTertiaryContainer">@color/surface_2</item>
        <item name="colorOnTertiaryContainer">@color/positive</item>
        <item name="colorError">@color/error</item>
        <item name="colorOnError">@color/on_error</item>
        <item name="colorErrorContainer">@color/surface_2</item>
        <item name="colorOnErrorContainer">@color/error</item>

        <item name="android:colorBackground">@color/ground</item>
        <item name="colorOnBackground">@color/text_primary</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/text_primary</item>
        <item name="colorSurfaceVariant">@color/surface_2</item>
        <item name="colorOnSurfaceVariant">@color/text_secondary</item>
        <item name="colorSurfaceInverse">@color/inverse_surface</item>
        <item name="colorOnSurfaceInverse">@color/inverse_text</item>
        <item name="colorSurfaceBright">@color/surface</item>
        <item name="colorSurfaceDim">@color/surface</item>
        <item name="colorSurfaceContainerLowest">@color/surface</item>
        <item name="colorSurfaceContainerLow">@color/surface</item>
        <item name="colorSurfaceContainer">@color/surface</item>
        <item name="colorSurfaceContainerHigh">@color/surface</item>
        <item name="colorSurfaceContainerHighest">@color/surface_2</item>
        <item name="colorOutline">@color/outline</item>
        <!-- Hairline dividers -->
        <item name="colorOutlineVariant">@color/surface_2</item>

        <item name="colorSurface2">@color/surface_2</item>
        <item name="colorAccentFill">@color/accent_fill</item>
        <item name="colorOnAccentFill">@color/on_accent_fill</item>
        <item name="colorPositive">@color/positive</item>
        <item name="colorOnPositive">@color/on_positive</item>

        <!-- Framework and AppCompat widgets (EditText, RadioButton, TimePicker) -->
        <item name="android:colorAccent">@color/accent</item>
        <item name="colorControlActivated">@color/accent</item>
        <item name="colorControlNormal">@color/text_secondary</item>

        <!-- Text with no colour of its own (M3 ships fixed greys here) -->
        <item name="android:textColorPrimary">@color/text_primary_states</item>
        <item name="android:textColorSecondary">@color/text_secondary_states</item>
        <item name="android:textColorTertiary">@color/text_secondary_states</item>
        <item name="android:textColorPrimaryInverse">@color/inverse_text</item>
        <item name="android:textColorHint">@color/text_secondary</item>

        <!-- Ground with the cyan glow, behind every screen -->
        <item name="android:windowBackground">@drawable/bg_ground</item>
        <item name="android:statusBarColor">@color/ground</item>
        <item name="android:navigationBarColor">@color/ground</item>
        <item name="android:windowLightStatusBar">@bool/light_system_bars</item>
        <item name="android:windowLightNavigationBar" tools:targetApi="27">@bool/light_system_bars</item>

        <!--
          Space Grotesk everywhere. Set at theme level so it reaches every TextView,
          which also means it outranks any family a textAppearance names; weights
          come from textStyle="bold" (700) or textFontWeight. Tabular figures
          everywhere, so times, counts and countdowns don't jitter.
        -->
        <item name="android:fontFamily">@font/space_grotesk</item>
        <item name="fontFamily">@font/space_grotesk</item>
        <item name="android:fontFeatureSettings">tnum</item>

        <!-- M3 titles and labels are medium weight -->
        <item name="textAppearanceTitleLarge">@style/TextAppearance.DailySync.TitleLarge</item>
        <item name="textAppearanceTitleMedium">@style/TextAppearance.DailySync.TitleMedium</item>
        <item name="textAppearanceTitleSmall">@style/TextAppearance.DailySync.TitleSmall</item>
        <item name="textAppearanceLabelLarge">@style/TextAppearance.DailySync.LabelLarge</item>
        <item name="textAppearanceLabelMedium">@style/TextAppearance.DailySync.LabelMedium</item>
        <item name="textAppearanceLabelSmall">@style/TextAppearance.DailySync.LabelSmall</item>

        <item name="materialButtonStyle">@style/Widget.DailySync.Button</item>
        <item name="materialButtonOutlinedStyle">@style/Widget.DailySync.Button.Outlined</item>
        <item name="borderlessButtonStyle">@style/Widget.DailySync.Button.TextButton</item>
        <item name="floatingActionButtonStyle">@style/Widget.DailySync.FloatingActionButton</item>
        <item name="chipStyle">@style/Widget.DailySync.Chip</item>
        <item name="materialCardViewStyle">@style/Widget.DailySync.CardView</item>
        <item name="switchStyle">@style/Widget.DailySync.Switch</item>
        <item name="materialSwitchStyle">@style/Widget.DailySync.MaterialSwitch</item>
        <item name="checkboxStyle">@style/Widget.DailySync.CheckBox</item>
        <item name="materialDividerStyle">@style/Widget.DailySync.Divider</item>
        <item name="android:progressBarStyleHorizontal">@style/Widget.DailySync.ProgressBar.Horizontal</item>
        <item name="materialAlertDialogTheme">@style/ThemeOverlay.DailySync.MaterialAlertDialog</item>
    </style>

    <!-- Type -->
    <style name="TextAppearance.DailySync.TitleLarge" parent="TextAppearance.Material3.TitleLarge">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.DailySync.TitleMedium" parent="TextAppearance.Material3.TitleMedium">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.DailySync.TitleSmall" parent="TextAppearance.Material3.TitleSmall">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.DailySync.LabelLarge" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.DailySync.LabelMedium" parent="TextAppearance.Material3.LabelMedium">
        <item name="android:textFontWeight">500</item>
    </style>
    <style name="TextAppearance.DailySync.LabelSmall" parent="TextAppearance.Material3.LabelSmall">
        <item name="android:textFontWeight">500</item>
    </style>

    <!-- Button labels are bold -->
    <style name="TextAppearance.DailySync.Button" parent="TextAppearance.Material3.LabelLarge">
        <item name="android:textStyle">bold</item>
        <item name="android:textFontWeight">700</item>
    </style>

    <!-- Shapes -->
    <style name="ShapeAppearance.DailySync.Full" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>
    <style name="ShapeAppearance.DailySync.Card" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">20dp</item>
    </style>

    <!-- Buttons: fully rounded, bold labels. Filled ones use the accent fill with a
         black label in both modes. -->
    <style name="Widget.DailySync.Button" parent="Widget.Material3.Button">
        <item name="backgroundTint">@color/button_accent_fill_bg</item>
        <item name="android:textColor">@color/button_on_accent_fill</item>
        <item name="iconTint">@color/button_on_accent_fill</item>
        <item name="android:textAppearance">@style/TextAppearance.DailySync.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <style name="Widget.DailySync.Button.Outlined" parent="Widget.Material3.Button.OutlinedButton">
        <item name="android:textAppearance">@style/TextAppearance.DailySync.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <style name="Widget.DailySync.Button.TextButton" parent="Widget.Material3.Button.TextButton">
        <item name="android:textAppearance">@style/TextAppearance.DailySync.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <style name="Widget.DailySync.Button.TextButton.Dialog" parent="Widget.Material3.Button.TextButton.Dialog">
        <item name="android:textAppearance">@style/TextAppearance.DailySync.Button</item>
        <item name="android:textStyle">bold</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <style name="Widget.DailySync.FloatingActionButton" parent="Widget.Material3.FloatingActionButton.Primary">
        <item name="backgroundTint">@color/button_accent_fill_bg</item>
        <item name="tint">@color/button_on_accent_fill</item>
        <item name="shapeAppearanceOverlay">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <style name="Widget.DailySync.Chip" parent="Widget.Material3.Chip.Assist">
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Full</item>
    </style>

    <!-- Cards: card surface, 20dp corners, no stroke, flat -->
    <style name="Widget.DailySync.CardView" parent="Widget.Material3.CardView.Filled">
        <item name="cardBackgroundColor">?attr/colorSurface</item>
        <item name="cardElevation">0dp</item>
        <item name="strokeWidth">0dp</item>
        <item name="shapeAppearance">@style/ShapeAppearance.DailySync.Card</item>
    </style>

    <!-- Switches: accent-fill track with a black thumb when on -->
    <style name="Widget.DailySync.Switch" parent="Widget.MaterialComponents.CompoundButton.Switch">
        <item name="useMaterialThemeColors">false</item>
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
    </style>

    <style name="Widget.DailySync.MaterialSwitch" parent="Widget.Material3.CompoundButton.MaterialSwitch">
        <item name="thumbTint">@color/switch_thumb</item>
        <item name="trackTint">@color/switch_track</item>
        <item name="trackDecorationTint">@color/switch_track</item>
    </style>

    <!-- Checkboxes: positive when ticked -->
    <style name="Widget.DailySync.CheckBox" parent="Widget.Material3.CompoundButton.CheckBox">
        <item name="useMaterialThemeColors">false</item>
        <item name="buttonTint">@color/checkbox_button</item>
        <item name="buttonIconTint">@color/checkbox_icon</item>
    </style>

    <!-- Hairline dividers: surface 2 -->
    <style name="Widget.DailySync.Divider" parent="Widget.Material3.MaterialDivider">
        <item name="dividerColor">?attr/colorSurface2</item>
    </style>

    <!-- Progress bars: fully rounded accent fill on a surface-2 track -->
    <style name="Widget.DailySync.ProgressBar.Horizontal" parent="android:Widget.Material.ProgressBar.Horizontal">
        <item name="android:progressDrawable">@drawable/progress_horizontal</item>
        <item name="android:minHeight">8dp</item>
        <item name="android:maxHeight">8dp</item>
    </style>

    <style name="ThemeOverlay.DailySync.MaterialAlertDialog" parent="ThemeOverlay.Material3.MaterialAlertDialog">
        <item name="buttonBarPositiveButtonStyle">@style/Widget.DailySync.Button.TextButton.Dialog</item>
        <item name="buttonBarNegativeButtonStyle">@style/Widget.DailySync.Button.TextButton.Dialog</item>
        <item name="buttonBarNeutralButtonStyle">@style/Widget.DailySync.Button.TextButton.Dialog</item>
    </style>

    <!-- Screen header: date or screen title, 26sp bold -->
    <style name="DailySync.ScreenTitle" parent="">
        <item name="android:textSize">26sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">-0.02</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- 44dp icon button: header cog, back arrow -->
    <style name="DailySync.IconButton" parent="">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:scaleType">center</item>
    </style>

    <!-- Header Home | Alarm pills: 36dp, fully rounded, bold. Selection is
         View.isSelected, which drives both the fill and the label colour. -->
    <style name="DailySync.TabPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pill_tab</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- One segment of a segmented control (Settings › Appearance) -->
    <style name="DailySync.Segment" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pill_segment</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Small uppercase group label above a settings card -->
    <style name="DailySync.GroupLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">22dp</item>
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:paddingStart">4dp</item>
        <item name="android:paddingEnd">4dp</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Settings card: rows inside, separated by DailySync.Hairline -->
    <style name="DailySync.SettingsCard" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">4dp</item>
        <item name="android:paddingBottom">4dp</item>
    </style>

    <style name="DailySync.Hairline" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">1dp</item>
        <item name="android:background">?attr/colorSurface2</item>
    </style>

    <!-- Row text inside a settings card -->
    <style name="DailySync.RowLabel" parent="">
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DailySync.RowValue" parent="DailySync.RowLabel">
        <item name="android:textColor">?attr/colorPrimary</item>
    </style>

    <style name="DailySync.RowHelp" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Home tiles: 16sp bold title, 13sp secondary line -->
    <style name="DailySync.TileTitle" parent="">
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <style name="DailySync.TileSubtitle" parent="">
        <item name="android:textSize">13sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- One open item in the To-Do tile, under a hairline -->
    <style name="DailySync.TileListItem" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">2dp</item>
        <item name="android:ellipsize">end</item>
        <item name="android:maxLines">2</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Coming-soon tile: dashed outline, secondary text, no click behaviour -->
    <style name="DailySync.ComingSoonTile" parent="">
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:background">@drawable/bg_tile_dashed</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="DailySync.ComingSoonTitle" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="DailySync.ComingSoonNote" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">2dp</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- One-of-two choice pill (Alarm tab Goal); View.isSelected picks it -->
    <style name="DailySync.ChoicePill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">38dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pill_choice</item>
        <item name="android:textColor">@color/pill_choice_text</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- Small outlined pill in the dev tools strip -->
    <style name="DailySync.DevToolButton" parent="Widget.DailySync.Button.Outlined">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">12dp</item>
        <item name="android:paddingEnd">12dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Pushed screens (wake-up sound, NFC, content, nuclear, PIN, manage lists):
         the scrolling column under view_screen_title -->
    <style name="DailySync.ScreenColumn" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">24dp</item>
    </style>

    <!-- A tappable row in a settings card: label left, value/chevron right -->
    <style name="DailySync.CardRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">10dp</item>
        <item name="android:paddingBottom">10dp</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- A switch row in a settings card: the switch's own label, bold -->
    <style name="DailySync.SwitchRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">52dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Round outlined icon button (sound preview): 44dp, accent icon -->
    <style name="DailySync.RoundIconButton" parent="Widget.DailySync.Button.Outlined">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">18dp</item>
        <item name="iconTint">?attr/colorPrimary</item>
    </style>

    <!-- −/+ stepper button: 40dp round outlined, text-coloured symbol -->
    <style name="DailySync.StepperButton" parent="Widget.DailySync.Button.Outlined">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="android:textSize">20sp</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Small choice pill on a card (5 min / 10 min): surface 2 when selected -->
    <style name="DailySync.SmallPill" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">34dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:gravity">center</item>
        <item name="android:background">@drawable/bg_pill_segment</item>
        <item name="android:textColor">@color/pill_text</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- A row in a manage list (tags, quotes, routines, stretches): its own card -->
    <style name="DailySync.ListCard" parent="">
        <item name="android:layout_marginBottom">8dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">@drawable/fg_card_ripple</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">8dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <!-- Alarm screens: the small uppercase label over a value or heading -->
    <style name="DailySync.AlarmLabel" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textAllCaps">true</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:letterSpacing">0.05</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Alarm screens: a stat's value under its label (colour set per stat) -->
    <style name="DailySync.AlarmStatValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginTop">4dp</item>
        <item name="android:textSize">22sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Alarm screens: one row of the "what's next" card -->
    <style name="DailySync.AlarmInfoRow" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
    </style>

    <style name="DailySync.AlarmInfoLabel" parent="">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_weight">1</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <style name="DailySync.AlarmInfoValue" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:layout_marginStart">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
    </style>

    <!-- Full-width 56dp step button (Continue, Start the day): the accent fill with
         a black label; disabled it falls back to surface 2 and secondary text -->
    <style name="DailySync.BigButton" parent="Widget.DailySync.Button">
        <item name="android:layout_height">56dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:textSize">17sp</item>
    </style>

    <!-- Rounded single-field input (to-do add, inbox compose): a pill outline, the
         hint inside the field rather than floating above it -->
    <style name="DailySync.PillInput" parent="Widget.Material3.TextInputLayout.OutlinedBox">
        <item name="hintEnabled">false</item>
        <item name="boxCornerRadiusTopStart">24dp</item>
        <item name="boxCornerRadiusTopEnd">24dp</item>
        <item name="boxCornerRadiusBottomStart">24dp</item>
        <item name="boxCornerRadiusBottomEnd">24dp</item>
        <item name="boxBackgroundColor">?android:attr/colorBackground</item>
    </style>

    <style name="DailySync.PillInputField" parent="">
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">18dp</item>
        <item name="android:paddingEnd">18dp</item>
        <item name="android:paddingTop">12dp</item>
        <item name="android:paddingBottom">12dp</item>
        <item name="android:textSize">15sp</item>
        <item name="android:textFontWeight">600</item>
    </style>

    <!-- Round accent-fill icon button with a black icon (inbox send) -->
    <style name="DailySync.RoundFilledButton" parent="Widget.DailySync.Button">
        <item name="android:layout_width">48dp</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">22dp</item>
    </style>

    <!-- Accent-fill pill with a black label beside a pill input (Add, Create) -->
    <style name="DailySync.PillButton" parent="Widget.DailySync.Button">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">48dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">20dp</item>
        <item name="android:paddingEnd">20dp</item>
        <item name="android:textSize">15sp</item>
    </style>

    <!-- A 128dp tile in a two-column grid (shopping lists): card surface -->
    <style name="DailySync.GridTile" parent="">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">128dp</item>
        <item name="android:layout_margin">5dp</item>
        <item name="android:orientation">vertical</item>
        <item name="android:padding">16dp</item>
        <item name="android:background">@drawable/bg_card</item>
        <item name="android:foreground">@drawable/fg_card_ripple</item>
        <item name="android:clickable">true</item>
        <item name="android:focusable">true</item>
    </style>

    <!-- The 40dp icon badge at the top of a grid tile -->
    <style name="DailySync.IconBadge" parent="">
        <item name="android:layout_width">40dp</item>
        <item name="android:layout_height">40dp</item>
        <item name="android:scaleType">center</item>
        <item name="android:background">@drawable/bg_icon_badge</item>
        <item name="android:importantForAccessibility">no</item>
    </style>

    <!-- Kitchen sign-in keypad: a 64dp round key on the card surface -->
    <style name="DailySync.KeypadKey" parent="Widget.DailySync.Button">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="backgroundTint">?attr/colorSurface</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">24sp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- The keypad's delete key: same footprint, no fill -->
    <style name="DailySync.KeypadDelete" parent="Widget.DailySync.Button.TextButton">
        <item name="android:layout_width">64dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:padding">0dp</item>
        <item name="iconGravity">textStart</item>
        <item name="iconPadding">0dp</item>
        <item name="iconSize">26dp</item>
        <item name="iconTint">?attr/colorOnSurface</item>
    </style>

    <!-- Week footer "‹ Wed 14" / "Fri 16 ›" links -->
    <style name="DailySync.WeekFooterLink" parent="">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minHeight">40dp</item>
        <item name="android:gravity">center_vertical</item>
        <item name="android:background">?attr/selectableItemBackground</item>
        <item name="android:textColor">?attr/colorPrimary</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <!-- Small outlined button in secondary text (the temporary abort control) -->
    <style name="DailySync.SmallOutlinedButton" parent="Widget.DailySync.Button.Outlined">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:minHeight">0dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:paddingStart">14dp</item>
        <item name="android:paddingEnd">14dp</item>
        <item name="android:textSize">13sp</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- Filled button in the error colour (nuclear Submit). The label is
         colorOnError: white on the light-mode red, black on the dark-mode red -->
    <style name="Widget.DailySync.Button.Error" parent="Widget.DailySync.Button">
        <item name="backgroundTint">@color/button_error_bg</item>
        <item name="android:textColor">@color/button_on_error</item>
        <item name="iconTint">@color/button_on_error</item>
    </style>

    <!-- Nuclear dismissal challenge cards -->
    <style name="NuclearCard">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">vertical</item>
        <item name="android:layout_marginTop">10dp</item>
        <item name="android:paddingStart">16dp</item>
        <item name="android:paddingEnd">16dp</item>
        <item name="android:paddingTop">14dp</item>
        <item name="android:paddingBottom">14dp</item>
        <item name="android:background">@drawable/bg_card</item>
    </style>

    <style name="NuclearCardHeader">
        <item name="android:layout_width">match_parent</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:orientation">horizontal</item>
        <item name="android:gravity">center_vertical</item>
    </style>

    <style name="NuclearStatus">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:minWidth">22dp</item>
        <item name="android:layout_marginEnd">8dp</item>
        <item name="android:text">○</item>
        <item name="android:textColor">?attr/colorOnSurfaceVariant</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NuclearCardTitle">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textSize">16sp</item>
        <item name="android:textStyle">bold</item>
    </style>

    <style name="NuclearInput">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:textColor">?attr/colorOnSurface</item>
        <item name="android:textColorHint">?attr/colorOnSurfaceVariant</item>
    </style>

    <!-- PIN keypad button: fixed-size text button, no min-width clutter -->
    <style name="PinKey" parent="Widget.DailySync.Button.TextButton">
        <item name="android:layout_width">72dp</item>
        <item name="android:layout_height">64dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:insetTop">0dp</item>
        <item name="android:insetBottom">0dp</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:textSize">22sp</item>
    </style>

    <!--
      Starting theme for MainActivity (the launcher entry): the launcher mark on
      black, from values/launcher_mark.xml via the adaptive-icon foreground. The
      icon drawable is 108dp with the mark inside the centre 72dp, the same
      safe zone as the launcher. installSplashScreen() swaps in the app theme.
    -->
    <style name="Theme.DailySync.Splash" parent="Theme.SplashScreen">
        <item name="windowSplashScreenBackground">@color/launcher_ground</item>
        <item name="windowSplashScreenAnimatedIcon">@drawable/ic_launcher_foreground</item>
        <item name="postSplashScreenTheme">@style/Theme.PersonalMorningAlarm</item>
    </style>
</resources>
