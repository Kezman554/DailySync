<?xml version="1.0" encoding="utf-8"?>
<!-- The cyan glow on the screen ground, centred on the top-right corner of
     drawable/bg_ground.xml's 100x190 viewport. Stop alphas differ by mode
     (values/colors.xml vs values-night/colors.xml). -->
<gradient xmlns:android="http://schemas.android.com/apk/res/android"
    android:type="radial"
    android:centerX="100"
    android:centerY="0"
    android:gradientRadius="190">
    <item android:offset="0" android:color="@color/ground_glow_core" />
    <item android:offset="0.4" android:color="@color/ground_glow_inner" />
    <item android:offset="0.7" android:color="@color/ground_glow_outer" />
    <item android:offset="0.9" android:color="@color/ground_glow_edge" />
</gradient>
