<?xml version="1.0" encoding="utf-8"?>
<!-- Space Grotesk (SIL OFL 1.1, docs/licenses/SpaceGrotesk-OFL.txt), bundled and
     never fetched at runtime. textStyle="bold" picks 700; textFontWeight picks any. -->
<font-family xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <font
        android:font="@font/space_grotesk_400"
        android:fontStyle="normal"
        android:fontWeight="400"
        app:font="@font/space_grotesk_400"
        app:fontStyle="normal"
        app:fontWeight="400" />
    <font
        android:font="@font/space_grotesk_500"
        android:fontStyle="normal"
        android:fontWeight="500"
        app:font="@font/space_grotesk_500"
        app:fontStyle="normal"
        app:fontWeight="500" />
    <font
        android:font="@font/space_grotesk_600"
        android:fontStyle="normal"
        android:fontWeight="600"
        app:font="@font/space_grotesk_600"
        app:fontStyle="normal"
        app:fontWeight="600" />
    <font
        android:font="@font/space_grotesk_700"
        android:fontStyle="normal"
        android:fontWeight="700"
        app:font="@font/space_grotesk_700"
        app:fontStyle="normal"
        app:fontWeight="700" />
</font-family>
