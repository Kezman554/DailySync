<?xml version="1.0" encoding="utf-8"?>
<!-- One list on the Shopping grid: the icon badge, the name, and "9 left" or
     "All done". The New list tile reuses it with a dashed outline. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    style="@style/DailySync.GridTile">

    <ImageView
        android:id="@+id/iv_shopping_list_badge"
        style="@style/DailySync.IconBadge"
        android:src="@drawable/ic_list" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <TextView
        android:id="@+id/tv_shopping_list_title"
        style="@style/DailySync.TileTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="Alfred tech" />

    <TextView
        android:id="@+id/tv_shopping_list_count"
        style="@style/DailySync.TileSubtitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:maxLines="1"
        tools:text="9 left" />

</LinearLayout>
