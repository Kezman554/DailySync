<?xml version="1.0" encoding="utf-8"?>
<!-- One note, as a card: the title, a two-line preview, and whether it's still on the
     phone. A tap opens it; a long press offers to delete it. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="8dp"
    android:background="@drawable/bg_card"
    android:foreground="?attr/selectableItemBackground"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingVertical="14dp">

    <TextView
        android:id="@+id/tv_note_title"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="1"
        android:textColor="?attr/colorOnSurface"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Boiler service questions" />

    <TextView
        android:id="@+id/tv_note_preview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:ellipsize="end"
        android:lineSpacingMultiplier="1.15"
        android:maxLines="2"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textFontWeight="600"
        android:textSize="13sp"
        android:visibility="gone"
        tools:text="Ask about the pressure drop, and whether the valve is still under warranty"
        tools:visibility="visible" />

    <!-- Only on notes still waiting in the offline queue. -->
    <TextView
        android:id="@+id/tv_note_pending"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/chalkboard_item_pending"
        android:textColor="?attr/colorPrimary"
        android:textSize="12sp"
        android:textStyle="bold|italic"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Only on notes Alfred refused: the text is safe on the phone, not in the vault. -->
    <TextView
        android:id="@+id/tv_note_refused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:text="@string/note_refused"
        android:textColor="?attr/colorError"
        android:textSize="12sp"
        android:textStyle="bold"
        android:visibility="gone" />
</LinearLayout>
