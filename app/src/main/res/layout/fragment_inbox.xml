<?xml version="1.0" encoding="utf-8"?>
<!--
  Inbox (the Inbox tile): the vault's 0-inbox/ captures as cards, read-only, and a
  compose bar docked at the bottom. Captures are accepted anywhere; offline they
  queue and show with a pending marker.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp">

    <!-- Title, with the capture count on the right -->
    <include
        android:id="@+id/title_bar"
        layout="@layout/view_screen_title" />

    <!-- Saved copy / captures waiting to sync -->
    <include
        android:id="@+id/sync_line"
        layout="@layout/view_sync_line" />

    <!-- Captures Alfred refused outright. Persistent, not a snackbar: the flush
         may happen while the user is elsewhere in the app. -->
    <LinearLayout
        android:id="@+id/row_inbox_refused"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_notice_error"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="6dp"
        android:paddingStart="16dp"
        android:paddingEnd="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_inbox_refused"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:textColor="?attr/colorError"
            android:textSize="14sp"
            android:textStyle="bold"
            tools:text="1 capture couldn’t be filed:\n• Buy dumbbells" />

        <Button
            android:id="@+id/btn_inbox_refused_dismiss"
            style="@style/Widget.DailySync.Button.TextButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/chalkboard_conflict_dismiss" />
    </LinearLayout>

    <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
        android:id="@+id/swipe_refresh"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginTop="12dp"
        android:layout_weight="1">

        <!-- NestedScrollView, not ScrollView: a wrap_content RecyclerView inside a
             plain ScrollView gets mis-measured and truncates the list (Card AF lesson). -->
        <androidx.core.widget.NestedScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Status messages only (loading / empty / unavailable) -->
                <TextView
                    android:id="@+id/tv_inbox_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingHorizontal="4dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="16sp"
                    android:textStyle="bold"
                    tools:text="Checking with Alfred…" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rv_inbox_captures"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:visibility="gone"
                    tools:itemCount="3"
                    tools:listitem="@layout/item_inbox_capture"
                    tools:visibility="visible" />
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>

    <!-- Compose bar, docked. The field is multi-line and so has no IME "done"
         action — a capture is free-form prose, and Enter should break the line
         rather than send. -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="bottom"
        android:orientation="horizontal"
        android:paddingVertical="12dp">

        <com.google.android.material.textfield.TextInputLayout
            android:id="@+id/til_inbox_capture"
            style="@style/DailySync.PillInput"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1">

            <com.google.android.material.textfield.TextInputEditText
                android:id="@+id/et_inbox_capture"
                style="@style/DailySync.PillInputField"
                android:hint="@string/inbox_capture_hint"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="top|start"
                android:inputType="textCapSentences|textMultiLine"
                android:maxLines="5"
                android:minLines="1" />
        </com.google.android.material.textfield.TextInputLayout>

        <Button
            android:id="@+id/btn_inbox_capture"
            style="@style/DailySync.RoundFilledButton"
            android:layout_marginStart="8dp"
            android:contentDescription="@string/inbox_capture_action"
            app:icon="@drawable/ic_send" />
    </LinearLayout>

</LinearLayout>
