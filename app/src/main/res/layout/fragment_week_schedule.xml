<?xml version="1.0" encoding="utf-8"?>
<!--
  Week (the Daily Schedule tile): a pill per plan day, the day pager, and a footer
  naming the days either side. The pager stays - swipe or tap a pill.
-->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:paddingHorizontal="16dp"
    android:paddingTop="12dp"
    android:paddingBottom="16dp">

    <include
        android:id="@+id/title_bar"
        layout="@layout/view_screen_title" />

    <!-- How old the Alfred data below is (FreshnessView) -->
    <include
        android:id="@+id/freshness"
        layout="@layout/view_freshness"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp" />

    <!-- One pill per plan day: abbreviation over date. WeekScheduleFragment fills it. -->
    <LinearLayout
        android:id="@+id/day_pills"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="12dp"
        android:orientation="horizontal"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- Loading / unavailable / no plan this week; the pager replaces it once
         there are days to swipe through. -->
    <TextView
        android:id="@+id/tv_week_status"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="4dp"
        android:paddingTop="16dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textSize="16sp"
        android:textStyle="bold"
        tools:text="Checking with Alfred…" />

    <androidx.viewpager2.widget.ViewPager2
        android:id="@+id/pager_week"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:visibility="gone"
        tools:visibility="visible" />

    <!-- ‹ Wed 14 · Swipe for other days · Fri 16 › -->
    <LinearLayout
        android:id="@+id/week_footer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="4dp"
        android:visibility="gone"
        tools:visibility="visible">

        <TextView
            android:id="@+id/tv_prev_day"
            style="@style/DailySync.WeekFooterLink"
            tools:text="‹ Wed 14" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="@string/week_swipe_hint"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tv_next_day"
            style="@style/DailySync.WeekFooterLink"
            tools:text="Fri 16 ›" />
    </LinearLayout>

</LinearLayout>
