<?xml version="1.0" encoding="utf-8"?>
<!-- One to-do row: a positive checkbox, the task (with a Family or Work tag in All), the
     date it went on the list on the right. Tap ticks, long-press drops. -->
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="?attr/selectableItemBackground"
    android:gravity="center_vertical"
    android:minHeight="52dp"
    android:orientation="horizontal"
    android:paddingVertical="8dp">

    <!-- Display only — the row itself is the tap target, so a half-awake thumb
         doesn't have to hit a checkbox. -->
    <CheckBox
        android:id="@+id/cb_todo"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:clickable="false"
        android:focusable="false"
        android:importantForAccessibility="no"
        android:minWidth="0dp"
        android:minHeight="0dp" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="8dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tv_todo_task"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:lineSpacingMultiplier="1.15"
            android:textColor="?attr/colorOnSurface"
            android:textFontWeight="600"
            android:textSize="15sp"
            tools:text="Plant the bamboo" />

        <!-- The Family or Work tag (in All), then the waiting-to-sync note; the row is
             gone when neither applies. -->
        <LinearLayout
            android:id="@+id/row_todo_marks"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="3dp"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_todo_tag"
                style="@style/DailySync.Tag"
                android:layout_marginEnd="8dp"
                android:visibility="gone"
                tools:visibility="visible" />

            <!-- Only on items still waiting in the offline queue. -->
            <TextView
                android:id="@+id/tv_todo_pending"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chalkboard_item_pending"
                android:textColor="?attr/colorPrimary"
                android:textSize="12sp"
                android:textStyle="bold|italic"
                android:visibility="gone"
                tools:visibility="visible" />
        </LinearLayout>
    </LinearLayout>

    <TextView
        android:id="@+id/tv_todo_date"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="6dp"
        android:textColor="?attr/colorOnSurfaceVariant"
        android:textFontWeight="600"
        android:textSize="13sp"
        tools:text="8 Apr" />
</LinearLayout>
