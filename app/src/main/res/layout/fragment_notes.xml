<?xml version="1.0" encoding="utf-8"?>
<!--
  Notes (the Notes tile): every note as a card, and a button to start another. Saves
  and deletes work anywhere, so unsent notes are listed along with the saved copy.
-->
<FrameLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingHorizontal="16dp"
        android:paddingTop="12dp">

        <!-- Title, with the note count on the right -->
        <include
            android:id="@+id/title_bar"
            layout="@layout/view_screen_title" />

        <!-- How old the Alfred data below is (FreshnessView) -->
        <include
            android:id="@+id/freshness"
            layout="@layout/view_freshness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp" />

        <!-- Changes waiting to sync -->
        <include
            android:id="@+id/sync_line"
            layout="@layout/view_sync_line" />

        <androidx.swiperefreshlayout.widget.SwipeRefreshLayout
            android:id="@+id/swipe_refresh"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="12dp"
            android:layout_weight="1">

            <!-- NestedScrollView, not ScrollView: a wrap_content RecyclerView inside a
                 plain ScrollView gets mis-measured and truncates the list (Card AF lesson). -->
            <androidx.core.widget.NestedScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <!-- The bottom padding lets the last note scroll clear of the button -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:paddingBottom="96dp">

                    <!-- Status messages only (loading / empty / unavailable) -->
                    <TextView
                        android:id="@+id/tv_notes_body"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:paddingHorizontal="4dp"
                        android:textColor="?attr/colorOnSurfaceVariant"
                        android:textSize="16sp"
                        android:textStyle="bold"
                        tools:text="Checking with Alfred…" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rv_notes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:visibility="gone"
                        tools:itemCount="3"
                        tools:listitem="@layout/item_note"
                        tools:visibility="visible" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>
        </androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
    </LinearLayout>

    <com.google.android.material.floatingactionbutton.FloatingActionButton
        android:id="@+id/fab_new_note"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="bottom|end"
        android:layout_margin="20dp"
        android:contentDescription="@string/notes_new"
        android:src="@drawable/ic_add"
        app:fabCustomSize="60dp" />

</FrameLayout>
