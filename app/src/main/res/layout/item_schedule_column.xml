<?xml version="1.0" encoding="utf-8"?>
<!-- One period in the Home schedule strip: a 4dp bar, the period label, its tasks,
     one line each.
     The bar and label colours are set per column (accent for the current period). -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="0dp"
    android:layout_height="wrap_content"
    android:layout_weight="1"
    android:minWidth="96dp"
    android:orientation="vertical">

    <View
        android:id="@+id/bar"
        android:layout_width="match_parent"
        android:layout_height="4dp"
        android:background="@drawable/bg_period_bar" />

    <TextView
        android:id="@+id/tv_period"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="6dp"
        android:textSize="12sp"
        android:textStyle="bold"
        tools:text="Morning" />

    <!-- One item_schedule_line per entry, filled by ScheduleStrip -->
    <LinearLayout
        android:id="@+id/tasks"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:orientation="vertical" />

</LinearLayout>
