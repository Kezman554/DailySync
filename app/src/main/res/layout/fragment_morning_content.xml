<?xml version="1.0" encoding="utf-8"?>
<!-- Morning content (Alarm tab tile header): which screens show between NFC taps,
     the stretch length, and the ways into quotes and stretch routines. -->
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <LinearLayout style="@style/DailySync.ScreenColumn">

        <include
            android:id="@+id/title_bar"
            layout="@layout/view_screen_title" />

        <TextView
            style="@style/DailySync.GroupLabel"
            android:text="@string/group_between_taps" />

        <LinearLayout style="@style/DailySync.SettingsCard">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_quote"
                style="@style/DailySync.SwitchRow"
                android:text="@string/toggle_quote" />

            <View style="@style/DailySync.Hairline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_stretch"
                style="@style/DailySync.SwitchRow"
                android:text="@string/toggle_stretch" />

            <View style="@style/DailySync.Hairline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_daily_schedule"
                style="@style/DailySync.SwitchRow"
                android:text="@string/toggle_daily_schedule" />

            <View style="@style/DailySync.Hairline" />

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/switch_chalkboard"
                style="@style/DailySync.SwitchRow"
                android:text="@string/toggle_chalkboard" />

            <View style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/row_manage_quotes"
                style="@style/DailySync.CardRow">

                <TextView
                    style="@style/DailySync.RowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_quotes" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>

            <View style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/row_manage_routines"
                style="@style/DailySync.CardRow">

                <TextView
                    style="@style/DailySync.RowLabel"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="@string/manage_routines" />

                <ImageView
                    android:layout_width="18dp"
                    android:layout_height="18dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_chevron_right" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>
</ScrollView>
