<?xml version="1.0" encoding="utf-8"?>
<!--
  The wake-up flow: Stage 1 (shake) and Stage 2 (NFC checkpoints), with the
  content screens between taps. One layout for all of it - AlarmDismissalActivity
  fills the shared parts (label, heading, stats, ring, info card) per stage.
  Follows the Appearance setting like the rest of the app, light mode included.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Stage label; in Stage 2 the time-left chip sits on the right, and stays up
         through the content screens too -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_stage_label"
            style="@style/DailySync.AlarmLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            tools:text="Stage 2 · Checkpoint 2 of 6" />

        <TextView
            android:id="@+id/tv_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="14:12 left"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Stage 1 / Stage 2 / done -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_row">

        <!-- "GO TO" / "WRONG TAG — FIND" (Stage 2); gone in Stage 1 -->
        <TextView
            android:id="@+id/tv_big_label"
            style="@style/DailySync.AlarmLabel"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:text="Go to"
            tools:visibility="visible" />

        <!-- The alarm time (Stage 1) or the tag to find (Stage 2) -->
        <TextView
            android:id="@+id/tv_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="72sp"
            android:textStyle="bold"
            tools:text="Bathroom" />

        <!-- Wrong tag: what was tapped and what's next, outlined in the error colour -->
        <LinearLayout
            android:id="@+id/notice_wrong_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice_error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wrong_tag" />

            <TextView
                android:id="@+id/tv_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="assertive"
                android:textColor="?attr/colorError"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="That was Kitchen. Bathroom is next." />
        </LinearLayout>

        <!-- Two label-over-value stats -->
        <LinearLayout
            android:id="@+id/stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stat_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_stat_1_label"
                    style="@style/DailySync.AlarmLabel"
                    tools:text="Shaken" />

                <TextView
                    android:id="@+id/tv_stat_1_value"
                    style="@style/DailySync.AlarmStatValue"
                    android:textColor="?attr/colorPositive"
                    tools:text="↗ 64%" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_stat_2_label"
                    style="@style/DailySync.AlarmLabel"
                    tools:text="Left" />

                <TextView
                    android:id="@+id/tv_stat_2_value"
                    style="@style/DailySync.AlarmStatValue"
                    tools:text="6s" />
            </LinearLayout>

            <!-- Done screen only: the streak -->
            <LinearLayout
                android:id="@+id/stat_3"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/tv_stat_3_label"
                    style="@style/DailySync.AlarmLabel"
                    android:text="@string/alarm_stat_streak" />

                <TextView
                    android:id="@+id/tv_stat_3_value"
                    style="@style/DailySync.AlarmStatValue"
                    android:textColor="?attr/colorPositive"
                    tools:text="↗ 1 day" />
            </LinearLayout>
        </LinearLayout>

        <!-- The ring, centred in whatever height is left -->
        <FrameLayout
            android:id="@+id/ring_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="220dp">

            <com.personalmorningalarm.ui.ProgressRingView
                android:id="@+id/ring"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/ring_centre"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="36dp">

                <ImageView
                    android:id="@+id/iv_ring_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ring_nfc"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_ring_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Shake hard to wake up" />
            </LinearLayout>

            <!-- No usable tags: a single confirm stands in for the checkpoints -->
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/tap_to_confirm"
                android:visibility="gone" />

            <!-- Unlock hint (NFC needs the phone unlocked) -->
            <TextView
                android:id="@+id/tv_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Unlock your phone to tap the tags"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- Done screen: closes the alarm -->
        <Button
            android:id="@+id/btn_start_day"
            style="@style/DailySync.BigButton"
            android:layout_width="match_parent"
            android:layout_marginTop="12dp"
            android:text="@string/alarm_start_the_day"
            android:visibility="gone" />

        <!-- What's next / what's at stake -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/info_row_1"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_1_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    tools:text="Still to find" />

                <TextView
                    android:id="@+id/tv_info_1_value"
                    style="@style/DailySync.AlarmInfoValue"
                    tools:text="4 more after this" />
            </LinearLayout>

            <View
                android:id="@+id/info_divider_2"
                style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/info_row_2"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_2_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    tools:text="Time to finish" />

                <TextView
                    android:id="@+id/tv_info_2_value"
                    style="@style/DailySync.AlarmInfoValue"
                    tools:text="15:00" />
            </LinearLayout>

            <View
                android:id="@+id/info_divider_3"
                style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/info_row_3"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_3_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    android:text="@string/alarm_info_if_time_runs_out" />

                <TextView
                    android:id="@+id/tv_info_3_value"
                    style="@style/DailySync.AlarmInfoValue"
                    android:text="@string/alarm_info_nuclear"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!--
      Content screens between taps: quote, stretch, today's schedule, rolling to-do.
      One frame for all four - a label (and, for schedule and to-do, a 44sp title),
      the screen's own block in a scroll, then the timed Continue: disabled until
      the step's timer finishes, the 56dp ring beside it counting down. The stretch
      gates Continue on its own big ring instead, so the small one hides there.
    -->
    <LinearLayout
        android:id="@+id/content_panel"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_marginTop="16dp"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_row"
        tools:visibility="gone">

        <TextView
            android:id="@+id/tv_content_label"
            style="@style/DailySync.AlarmLabel"
            android:layout_marginTop="8dp"
            tools:text="Take a moment" />

        <TextView
            android:id="@+id/tv_content_title"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:textColor="?attr/colorOnSurface"
            android:textSize="44sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="Friday 16 Oct"
            tools:visibility="visible" />

        <!-- Schedule: the day's all-day markers (e.g. a WFH day), when there are any -->
        <TextView
            android:id="@+id/tv_content_subtitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textFontWeight="600"
            android:textSize="15sp"
            android:visibility="gone"
            tools:text="WFH day"
            tools:visibility="visible" />

        <!-- How old the schedule or to-do is (FreshnessView). Read half awake, so a
             saved copy from an earlier day gets the full error-outlined notice -->
        <include
            android:id="@+id/content_freshness"
            layout="@layout/view_freshness"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp" />

        <ScrollView
            android:id="@+id/content_scroll"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:fillViewport="true">

            <LinearLayout
                android:id="@+id/content_block"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <!-- Quote text (36sp bold), or a one-line state like "Checking with Alfred…" -->
                <TextView
                    android:id="@+id/content_body"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:letterSpacing="-0.02"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="36sp"
                    android:textStyle="bold"
                    tools:text="“It always seems impossible until it’s done.”" />

                <TextView
                    android:id="@+id/content_author"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="18dp"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="17sp"
                    android:textStyle="bold"
                    android:visibility="gone"
                    tools:text="— Nelson Mandela"
                    tools:visibility="visible" />

                <!-- Stretch: the session timer, then the stretches -->
                <FrameLayout
                    android:id="@+id/stretch_ring_area"
                    android:layout_width="210dp"
                    android:layout_height="210dp"
                    android:layout_gravity="center_horizontal"
                    android:visibility="gone">

                    <com.personalmorningalarm.ui.ProgressRingView
                        android:id="@+id/stretch_ring"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/tv_stretch_time"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:includeFontPadding="false"
                            android:letterSpacing="-0.03"
                            android:textColor="?attr/colorPrimary"
                            android:textSize="52sp"
                            android:textStyle="bold"
                            tools:text="3:48" />

                        <TextView
                            android:id="@+id/tv_stretch_of"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="4dp"
                            android:textColor="?attr/colorOnSurfaceVariant"
                            android:textSize="14sp"
                            android:textStyle="bold"
                            tools:text="of 5:00" />
                    </LinearLayout>
                </FrameLayout>

                <LinearLayout
                    android:id="@+id/stretch_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />

                <!-- Schedule: the opened day, as on the week screen (full wording) -->
                <LinearLayout
                    android:id="@+id/schedule_rows"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="18dp"
                    android:paddingVertical="10dp"
                    android:visibility="gone" />

                <!-- Rolling to-do: checkboxes, hairlines between -->
                <LinearLayout
                    android:id="@+id/todo_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/bg_card"
                    android:orientation="vertical"
                    android:paddingHorizontal="12dp"
                    android:paddingVertical="4dp"
                    android:visibility="gone" />
            </LinearLayout>
        </ScrollView>

        <!-- The timed Continue -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <Button
                android:id="@+id/btn_continue"
                style="@style/DailySync.BigButton"
                android:layout_width="0dp"
                android:layout_weight="1"
                android:text="@string/content_continue" />

            <FrameLayout
                android:id="@+id/continue_timer"
                android:layout_width="56dp"
                android:layout_height="56dp"
                android:layout_marginStart="12dp"
                android:contentDescription="@string/content_continue_unlocks">

                <com.personalmorningalarm.ui.ProgressRingView
                    android:id="@+id/continue_ring"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <TextView
                    android:id="@+id/tv_continue_seconds"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:importantForAccessibility="no"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="14sp"
                    android:textStyle="bold"
                    tools:text="12s" />
            </FrameLayout>
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
