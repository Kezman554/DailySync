<?xml version="1.0" encoding="utf-8"?>
<!--
  The wake-up flow: Stage 1 (shake) and Stage 2 (NFC checkpoints), with the
  content screens between taps. One layout for all of it - AlarmDismissalActivity
  fills the shared parts (label, heading, stats, ring, info card) per stage.
  Follows the Appearance setting like the rest of the app, light mode included.
-->
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:paddingHorizontal="20dp"
    android:paddingTop="16dp"
    android:paddingBottom="12dp">

    <!-- Stage label; in Stage 2 the time-left chip sits on the right, and stays up
         through the content screens too -->
    <LinearLayout
        android:id="@+id/top_row"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:minHeight="32dp"
        android:orientation="horizontal"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/tv_stage_label"
            style="@style/DailySync.AlarmLabel"
            android:layout_width="0dp"
            android:layout_weight="1"
            tools:text="Stage 2 · Checkpoint 2 of 6" />

        <TextView
            android:id="@+id/tv_time_left"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:background="@drawable/bg_chip"
            android:paddingHorizontal="12dp"
            android:paddingVertical="6dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="15sp"
            android:textStyle="bold"
            android:visibility="gone"
            tools:text="14:12 left"
            tools:visibility="visible" />
    </LinearLayout>

    <!-- Stage 1 / Stage 2 / done -->
    <LinearLayout
        android:id="@+id/content"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toTopOf="@id/btn_stop_alarm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_row">

        <!-- "GO TO" / "WRONG TAG — FIND" (Stage 2); gone in Stage 1 -->
        <TextView
            android:id="@+id/tv_big_label"
            style="@style/DailySync.AlarmLabel"
            android:layout_marginTop="16dp"
            android:visibility="gone"
            tools:text="Go to"
            tools:visibility="visible" />

        <!-- The alarm time (Stage 1) or the tag to find (Stage 2) -->
        <TextView
            android:id="@+id/tv_big"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:ellipsize="end"
            android:includeFontPadding="false"
            android:letterSpacing="-0.03"
            android:maxLines="2"
            android:textColor="?attr/colorOnSurface"
            android:textSize="72sp"
            android:textStyle="bold"
            tools:text="Bathroom" />

        <!-- Wrong tag: what was tapped and what's next, outlined in the error colour -->
        <LinearLayout
            android:id="@+id/notice_wrong_tag"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="@drawable/bg_notice_error"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="16dp"
            android:paddingVertical="14dp"
            android:visibility="gone"
            tools:visibility="visible">

            <ImageView
                android:layout_width="22dp"
                android:layout_height="22dp"
                android:importantForAccessibility="no"
                android:src="@drawable/ic_wrong_tag" />

            <TextView
                android:id="@+id/tv_notice"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:accessibilityLiveRegion="assertive"
                android:textColor="?attr/colorError"
                android:textSize="15sp"
                android:textStyle="bold"
                tools:text="That was Kitchen. Bathroom is next." />
        </LinearLayout>

        <!-- Two label-over-value stats -->
        <LinearLayout
            android:id="@+id/stats_row"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/stat_1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_stat_1_label"
                    style="@style/DailySync.AlarmLabel"
                    tools:text="Shaken" />

                <TextView
                    android:id="@+id/tv_stat_1_value"
                    style="@style/DailySync.AlarmStatValue"
                    android:textColor="?attr/colorPositive"
                    tools:text="↗ 64%" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/stat_2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="36dp"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tv_stat_2_label"
                    style="@style/DailySync.AlarmLabel"
                    tools:text="Left" />

                <TextView
                    android:id="@+id/tv_stat_2_value"
                    style="@style/DailySync.AlarmStatValue"
                    tools:text="6s" />
            </LinearLayout>
        </LinearLayout>

        <!-- The ring, centred in whatever height is left -->
        <FrameLayout
            android:id="@+id/ring_area"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:minHeight="220dp">

            <com.personalmorningalarm.ui.ProgressRingView
                android:id="@+id/ring"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:id="@+id/ring_centre"
                android:layout_width="210dp"
                android:layout_height="210dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:orientation="vertical"
                android:paddingHorizontal="36dp">

                <ImageView
                    android:id="@+id/iv_ring_icon"
                    android:layout_width="40dp"
                    android:layout_height="40dp"
                    android:importantForAccessibility="no"
                    android:src="@drawable/ic_ring_nfc"
                    android:visibility="gone"
                    tools:visibility="visible" />

                <TextView
                    android:id="@+id/tv_ring_text"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:gravity="center"
                    android:lineSpacingMultiplier="1.1"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    tools:text="Shake hard to wake up" />
            </LinearLayout>

            <!-- No usable tags: a single confirm stands in for the checkpoints -->
            <Button
                android:id="@+id/btn_confirm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="@string/tap_to_confirm"
                android:visibility="gone" />

            <!-- Unlock hint (NFC needs the phone unlocked) -->
            <TextView
                android:id="@+id/tv_note"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom|center_horizontal"
                android:layout_marginBottom="4dp"
                android:gravity="center"
                android:textColor="?attr/colorOnSurfaceVariant"
                android:textSize="14sp"
                android:textStyle="bold"
                android:visibility="gone"
                tools:text="Unlock your phone to tap the tags"
                tools:visibility="visible" />
        </FrameLayout>

        <!-- What's next / what's at stake -->
        <LinearLayout
            android:id="@+id/info_card"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_card"
            android:orientation="vertical"
            android:paddingHorizontal="18dp"
            android:paddingVertical="4dp">

            <LinearLayout
                android:id="@+id/info_row_1"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_1_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    tools:text="Still to find" />

                <TextView
                    android:id="@+id/tv_info_1_value"
                    style="@style/DailySync.AlarmInfoValue"
                    tools:text="4 more after this" />
            </LinearLayout>

            <View
                android:id="@+id/info_divider_2"
                style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/info_row_2"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_2_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    tools:text="Time to finish" />

                <TextView
                    android:id="@+id/tv_info_2_value"
                    style="@style/DailySync.AlarmInfoValue"
                    tools:text="15:00" />
            </LinearLayout>

            <View
                android:id="@+id/info_divider_3"
                style="@style/DailySync.Hairline" />

            <LinearLayout
                android:id="@+id/info_row_3"
                style="@style/DailySync.AlarmInfoRow">

                <TextView
                    android:id="@+id/tv_info_3_label"
                    style="@style/DailySync.AlarmInfoLabel"
                    android:text="@string/alarm_info_if_time_runs_out" />

                <TextView
                    android:id="@+id/tv_info_3_value"
                    style="@style/DailySync.AlarmInfoValue"
                    android:text="@string/alarm_info_nuclear"
                    android:textColor="?attr/colorError" />
            </LinearLayout>
        </LinearLayout>

    </LinearLayout>

    <!-- Content screen (quote / stretch / schedule / to-do), between
         checkpoints. constrainedHeight keeps a long list inside the panel's bounds
         instead of growing past the Stop button; content_list_scroll gives way. -->
    <LinearLayout
        android:id="@+id/content_panel"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center_horizontal"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constrainedHeight="true"
        app:layout_constraintBottom_toTopOf="@id/btn_stop_alarm"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/top_row"
        android:layout_marginTop="16dp"
        tools:visibility="gone">

        <TextView
            android:id="@+id/content_heading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            tools:text="Take a moment" />

        <!-- Status line under the heading, for any content screen that needs one
             (e.g. an Alfred screen showing a cached response). -->
        <TextView
            android:id="@+id/content_note"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="Saved copy — Alfred unreachable"
            tools:visibility="visible" />

        <!-- Stretch "X of N" progress (stretch screen only) -->
        <TextView
            android:id="@+id/tv_stretch_progress"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:textAppearance="?attr/textAppearanceLabelLarge"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="Stretch 2 of 5"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/content_body"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:gravity="center"
            android:textAppearance="?attr/textAppearanceHeadlineSmall"
            android:textColor="?attr/colorOnSurface"
            tools:text="It always seems impossible until it's done." />

        <TextView
            android:id="@+id/content_author"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            android:textAppearance="?attr/textAppearanceTitleSmall"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="— Nelson Mandela"
            tools:visibility="visible" />

        <!-- Long start-aligned list, unlike the centred single-block content_body
             the other screens use. Shared by the Alfred screens (schedule, rolling
             to-do), whose real content runs to many lines. -->
        <ScrollView
            android:id="@+id/content_list_scroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:layout_weight="1"
            android:visibility="gone"
            tools:visibility="visible">

            <TextView
                android:id="@+id/tv_content_list"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:lineSpacingMultiplier="1.15"
                android:textAppearance="?attr/textAppearanceBodyLarge"
                android:textColor="?attr/colorOnSurface"
                tools:text="Morning\n• Gym" />

        </ScrollView>

        <TextView
            android:id="@+id/content_timer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:textColor="?attr/colorOnSurface"
            android:textSize="48sp"
            android:visibility="gone"
            tools:text="5:00"
            tools:visibility="visible" />

        <TextView
            android:id="@+id/tv_continue_countdown"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textColor="?attr/colorOnSurface"
            android:visibility="gone"
            tools:text="15s"
            tools:visibility="visible" />

        <Button
            android:id="@+id/btn_continue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/content_continue" />

    </LinearLayout>

    <!-- TODO(temporary): abort control for testing Stage 1/2. Its future is a
         separate decision; kept small and quiet until then. -->
    <Button
        android:id="@+id/btn_stop_alarm"
        style="@style/DailySync.SmallOutlinedButton"
        android:layout_marginTop="10dp"
        android:text="@string/abort_temp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
