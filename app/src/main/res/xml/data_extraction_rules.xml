<?xml version="1.0" encoding="utf-8"?>
<!--
  What Android backs up on Android 12 and later (backup_rules.xml is the same for
  older versions: change both together).

  Lists and notes kept on the phone are in databases/phone_lists.db
  (PhoneListDatabase.DB_NAME). The database domain is included whole, so that file
  goes in the backup and so does its journal, and a lost phone doesn't lose the
  lists while backup is on. BackupRulesTest fails if either file stops covering it.

  The rest is what Android backed up before these rules existed: the alarm's
  database, the settings, and the saved Alfred responses.
-->
<data-extraction-rules>
    <cloud-backup>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </cloud-backup>
    <device-transfer>
        <include domain="database" path="." />
        <include domain="sharedpref" path="." />
        <include domain="file" path="." />
    </device-transfer>
</data-extraction-rules>
